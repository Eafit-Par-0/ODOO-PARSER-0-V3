<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Text & Formatting -->
        <record id="rule_strip_whitespace" model="import.cleansing.rule">
            <field name="name">Quitar espacios sobrantes</field>
            <field name="category">text</field>
            <field name="sequence">5</field>
            <field name="action_type">strip</field>
            <field name="test_input">  John Doe  </field>
            <field name="description">Quita los espacios al inicio y al final del texto.</field>
        </record>

        <record id="rule_titlecase" model="import.cleansing.rule">
            <field name="name">Primera letra en mayúscula</field>
            <field name="category">text</field>
            <field name="sequence">10</field>
            <field name="action_type">titlecase</field>
            <field name="test_input">juan perez rodriguez</field>
            <field name="description">Pone en mayúscula la primera letra de cada palabra (ej. Juan Perez Rodriguez).</field>
        </record>

        <record id="rule_uppercase" model="import.cleansing.rule">
            <field name="name">Convertir a mayúsculas</field>
            <field name="category">text</field>
            <field name="sequence">15</field>
            <field name="action_type">uppercase</field>
            <field name="test_input">bogota d.c.</field>
            <field name="description">Convierte todas las letras a MAYÚSCULAS.</field>
        </record>

        <record id="rule_lowercase" model="import.cleansing.rule">
            <field name="name">Convertir a minúsculas</field>
            <field name="category">text</field>
            <field name="sequence">20</field>
            <field name="action_type">lowercase</field>
            <field name="test_input">ADMIN@COMPANY.COM</field>
            <field name="description">Convierte todas las letras a minúsculas.</field>
        </record>

        <record id="rule_remove_accents" model="import.cleansing.rule">
            <field name="name">Quitar tildes</field>
            <field name="category">text</field>
            <field name="sequence">25</field>
            <field name="action_type">remove_accents</field>
            <field name="test_input">Medellín, Antioquia, Bogotá</field>
            <field name="description">Reemplaza las letras con tilde por su equivalente sin tilde (ej. á -&gt; a, ñ -&gt; n).</field>
        </record>

        <record id="rule_digits_only" model="import.cleansing.rule">
            <field name="name">Dejar solo dígitos</field>
            <field name="category">text</field>
            <field name="sequence">30</field>
            <field name="action_type">digits_only</field>
            <field name="test_input">Order #123-456 (Ref: 789)</field>
            <field name="description">Quita todo lo que no sea un número.</field>
        </record>

        <!-- Contacts & Tax IDs -->
        <record id="rule_normalize_email" model="import.cleansing.rule">
            <field name="name">Normalizar correo</field>
            <field name="category">contact</field>
            <field name="sequence">35</field>
            <field name="action_type">email</field>
            <field name="test_input">  &lt;Client.Contact@example.com&gt;  </field>
            <field name="description">Limpia los correos: quita espacios, pasa a minúsculas y extrae la dirección.</field>
        </record>

        <record id="rule_normalize_phone" model="import.cleansing.rule">
            <field name="name">Normalizar teléfono / celular</field>
            <field name="category">contact</field>
            <field name="sequence">40</field>
            <field name="action_type">phone</field>
            <field name="test_input">+57 (300) 123-4567</field>
            <field name="description">Limpia los teléfonos: quita espacios, guiones y paréntesis, y conserva el indicativo del país.</field>
        </record>

        <record id="rule_normalize_vat" model="import.cleansing.rule">
            <field name="name">Normalizar NIT / documento</field>
            <field name="category">contact</field>
            <field name="sequence">45</field>
            <field name="action_type">vat_document</field>
            <field name="test_input">900.123.456-7</field>
            <field name="description">Limpia NIT/RUT/documentos: quita puntos y espacios internos y pasa a mayúsculas.</field>
        </record>

        <!-- Numbers & Currency -->
        <record id="rule_clean_currency_cop" model="import.cleansing.rule">
            <field name="name">Limpiar moneda ($ COP / USD)</field>
            <field name="category">number</field>
            <field name="sequence">50</field>
            <field name="action_type">number_clean</field>
            <field name="decimal_separator">comma</field>
            <field name="test_input">$ 1.500.000,50 COP</field>
            <field name="description">Quita símbolos de moneda ($, COP, USD) y convierte la coma decimal al formato estándar.</field>
        </record>

        <!-- Dates & Times -->
        <record id="rule_normalize_date_iso" model="import.cleansing.rule">
            <field name="name">Normalizar fecha a ISO (AAAA-MM-DD)</field>
            <field name="category">date</field>
            <field name="sequence">55</field>
            <field name="action_type">date_format</field>
            <field name="date_input_format">auto</field>
            <field name="test_input">31/12/2025</field>
            <field name="description">Convierte fechas (DD/MM/AAAA, MM/DD/AAAA) al formato ISO estándar (AAAA-MM-DD).</field>
        </record>
    </data>
</odoo>
