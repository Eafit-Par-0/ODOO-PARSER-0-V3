<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="group_smart_importer_admin" model="res.groups">
            <field name="name">Importador Inteligente / Administrador</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('smart_data_importer.group_smart_importer_admin'))]"/>
        </record>

        <record id="rule_import_session_personal" model="ir.rule">
            <field name="name">Sesiones de importación propias</field>
            <field name="model_id" ref="model_import_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <record id="rule_import_session_all" model="ir.rule">
            <field name="name">Todas las sesiones de importación</field>
            <field name="model_id" ref="model_import_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [ref('base.group_system')])]"/>
        </record>
    </data>
</odoo>