<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_import_template" model="ir.actions.act_window">
        <field name="name">Plantillas de importación</field>
        <field name="res_model">import.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea o administra plantillas de importación reutilizables.
            </p>
            <p>
                Las plantillas mapean automáticamente los archivos recurrentes según sus encabezados, lo que ahorra tiempo y evita errores.
            </p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_import_template_list" model="ir.ui.view">
        <field name="name">import.template.list</field>
        <field name="model">import.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="line_count" string="Columnas"/>
                <field name="duplicate_criterion"/>
                <field name="duplicate_policy"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_import_template_form" model="ir.ui.view">
        <field name="name">import.template.form</field>
        <field name="model">import.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="ej. Reporte mensual de proveedores en Excel"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Configuración de destino">
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="active"/>
                        </group>
                        <group string="Política de duplicados por defecto">
                            <field name="duplicate_criterion"/>
                            <field name="duplicate_policy"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="lines" string="Mapeo de columnas y reglas">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_header"/>
                                    <field name="target_field_id" options="{'no_create': True}"
                                           domain="[('model_id', '=', parent.model_id)]"/>
                                    <field name="target_subfield" optional="hide"/>
                                    <field name="cleansing_rule_ids" widget="many2many_tags" options="{'color_field': 'action_type'}"/>
                                    <field name="is_ignored" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>

                        <page name="signature" string="Firma de encabezados (detección automática)">
                            <group>
                                <field name="header_signature" readonly="1"/>
                                <field name="header_list" readonly="1"/>
                            </group>
                        </page>

                        <page name="description" string="Documentación y notas">
                            <field name="description" placeholder="Anota el sistema de origen, el proveedor, la frecuencia o instrucciones especiales de esta plantilla..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_import_template_search" model="ir.ui.view">
        <field name="name">import.template.search</field>
        <field name="model">import.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Modelo" name="group_by_model" context="{'group_by': 'model_id'}"/>
                    <filter string="Política de duplicados" name="group_by_policy" context="{'group_by': 'duplicate_policy'}"/>   
                </group>
            </search>
        </field>
    </record>
</odoo>
