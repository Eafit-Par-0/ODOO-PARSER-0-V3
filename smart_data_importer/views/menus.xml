<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Level Menu -->
    <menuitem id="menu_smart_importer_root"
              name="Smart Importer"
              sequence="50"
              groups="base.group_user"/>

    <!-- Submenus -->
    <menuitem id="menu_smart_importer_sessions"
              name="Sessions"
              parent="menu_smart_importer_root"
              action="action_import_session"
              sequence="10"/>

    <menuitem id="menu_smart_importer_templates"
              name="Templates"
              parent="menu_smart_importer_root"
              action="action_import_template"
              sequence="20"/>

    <menuitem id="menu_smart_importer_config"
              name="Configuration"
              parent="menu_smart_importer_root"
              sequence="100"
              groups="base.group_user"/>

    <menuitem id="menu_smart_importer_cleansing_rules"
              name="Cleansing Rules"
              parent="menu_smart_importer_config"
              action="action_import_cleansing_rule"
              sequence="10"/>

    <menuitem id="menu_smart_importer_value_memory"
              name="Memoria de valores"
              parent="menu_smart_importer_config"
              action="action_import_value_memory"
              groups="smart_data_importer.group_smart_importer_admin"
              sequence="30"/>

    <menuitem id="menu_smart_importer_header_memory"
              name="Sinónimos y memoria de encabezados"
              parent="menu_smart_importer_config"
              action="action_mapping_registry"
              sequence="40"/>

    <menuitem id="menu_smart_importer_settings"
              name="Settings"
              parent="menu_smart_importer_config"
              action="action_smart_importer_configuration"
              sequence="20"/>
</odoo>
