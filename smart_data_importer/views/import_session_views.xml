<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_import_session" model="ir.actions.act_window">
        <field name="name">Sesiones de importación</field>
        <field name="res_model">import.session</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva sesión de importación.
            </p>
            <p>
                Sube un archivo CSV o Excel. Se admiten libros con varias hojas (instrucciones, posibles valores, datos): elige la hoja y el modelo de Odoo en el que vas a importar.
            </p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_import_session_list" model="ir.ui.view">
        <field name="name">import.session.list</field>
        <field name="model">import.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="filename"/>
                <field name="sheet_id" optional="show"/>
                <field name="target_model_id" optional="show"/>
                <field name="create_date"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'queued')"
                       decoration-warning="state in ('analyzing', 'processing')"
                       decoration-success="state in ('mapped', 'done')"
                       decoration-danger="state == 'error'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_import_session_form" model="ir.ui.view">
        <field name="name">import.session.form</field>
        <field name="model">import.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_file" string="Procesar archivo" type="object" class="btn-primary"
                            icon="fa-upload" invisible="state != 'draft' or sheet_ids"/>
                    <button name="action_ai_prepare_and_upload_template" string="🤖 Preparar y Subir Plantilla con IA" type="object" class="btn-primary"
                            invisible="state != 'draft' or not sheet_ids"/>
                    <button name="action_analyze" string="Analizar (Local / Caché)" type="object" class="btn-secondary"
                            invisible="state != 'draft' or not sheet_ids"/>
                    <button name="action_ai_prepare_and_upload_template" string="🤖 Re-analizar y Actualizar Plantilla con IA" type="object" class="btn-secondary"
                            invisible="state != 'mapped'"/>
                    <button name="action_save_as_template" string="Guardar como Plantilla" type="object" class="btn-secondary"
                            invisible="state != 'mapped'"/>
                    <button name="action_confirm_mapping" string="Confirmar e Importar" type="object" class="btn-primary"
                            invisible="state != 'mapped'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,analyzing,mapped,queued,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" role="status" invisible="state != 'draft' or sheet_ids">
                        <strong>Paso 1:</strong> selecciona tu archivo CSV o Excel y pulsa <strong>Procesar archivo</strong>.
                        El sistema leerá las hojas del libro y detectará el modelo de Odoo automáticamente.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not model_detection_note or state != 'draft'">
                        <field name="model_detection_note" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="required_missing_count == 0">
                    <div class="alert alert-warning" role="alert"
                        invisible="not is_mixed_models or state not in ('draft', 'analyzing', 'mapped')">
                        <strong>Este archivo mezcla datos de varios módulos:</strong>
                        <field name="mixed_models_text" readonly="1"/>.
                        En esta sesión solo se importará la hoja
                        <strong><field name="sheet_id" readonly="1" options="{'no_open': True}"/></strong>
                        en <strong><field name="target_model_id" readonly="1" options="{'no_open': True}"/></strong>.
                        Para las demás hojas crea una sesión nueva con el mismo archivo y elige la hoja correspondiente.
                    </div>
                        Hay <field name="required_missing_count" class="fw-bold"/> celdas vacías en columnas marcadas como obligatorias en la plantilla.
                        Revisa la columna "Vacías" en el mapeo.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="value_issue_pending_count == 0 or state != 'mapped'">
                        Hay <field name="value_issue_pending_count" class="fw-bold"/> valores que no existen en Odoo.
                        Revísalos en la pestaña <strong>Valores a revisar</strong> (la sugerencia se basa en similitud de escritura).
                        <button name="action_accept_value_suggestions" type="object" class="btn btn-link"
                                string="Aceptar sugerencias seguras"/>
                    </div>
                    <div class="alert alert-info" role="status" invisible="value_memory_applied_count == 0">
                        <field name="value_memory_applied_count" class="fw-bold"/> valores se corrigieron con la memoria.
                        Puedes revisarlos o cambiarlos en la pestaña <strong>Valores a revisar</strong>.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="value_overflow_count == 0">
                        Hay <field name="value_overflow_count" class="fw-bold"/> columnas con demasiados valores desconocidos;
                        revisa el mapeo (probablemente la columna está asignada al campo equivocado).
                    </div>
                    <!-- Requisito 2: columnas que no pertenecen al modelo -->
                    <div class="alert alert-warning" role="alert"
                         invisible="state not in ('mapped', 'analyzing') or (foreign_column_count == 0 and unknown_column_count == 0)">
                        <div invisible="foreign_column_count == 0">
                            <strong>Hay <field name="foreign_column_count" class="fw-bold"/> columnas que no pertenecen a
                            <field name="target_model_id" readonly="1" options="{'no_open': True}" class="fw-bold"/>:</strong>
                            <field name="foreign_columns_text" readonly="1"/>.
                            Son campos de otro modelo de Odoo: las que no tienen campo asignado no se importarán,
                            y las que la IA o la similitud asignaron a otro campo debes confirmarlas.
                            <span invisible="not foreign_model_hint">
                                Parecen ser de <strong><field name="foreign_model_hint" readonly="1"/></strong>:
                                ¿elegiste el modelo destino correcto?
                            </span>
                        </div>
                        <div invisible="unknown_column_count == 0">
                            <strong><field name="unknown_column_count" class="fw-bold"/> columnas no tienen un campo equivalente:</strong>
                            <field name="unknown_columns_text" readonly="1"/>.
                            Asígnalas a mano en el mapeo o ignóralas.
                        </div>
                        <div>Mira la columna <strong>¿Pertenece?</strong> en la pestaña Mapeo de Columnas.
                            <button name="action_ignore_foreign_columns" type="object" class="btn btn-link"
                                    string="Ignorar estas columnas" invisible="state != 'mapped'"/>
                        </div>
                    </div>
                    <!-- Requisito 1: errores agrupados por columna -->
                    <div class="alert alert-danger" role="alert" invisible="state != 'mapped' or precheck_problem_count == 0">
                        Se detectaron <field name="precheck_problem_count" class="fw-bold"/> problemas en
                        <field name="precheck_column_count" class="fw-bold"/> columnas que Odoo no va a aceptar.
                        Revísalos en la pestaña <strong>Errores por columna</strong> antes de importar
                        (las filas con errores no se importarán).
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state not in ('done', 'error') or failed_rows == 0">
                        <field name="failed_rows" class="fw-bold" readonly="1"/> filas no se importaron, con errores en
                        <field name="import_error_column_count" class="fw-bold"/> columnas.
                        Revisa la pestaña <strong>Errores por columna</strong>: allí dice qué pasó y cómo corregirlo.
                    </div>
                    <group>
                        <group string="Archivo y carga">
                            <field name="filename" invisible="1"/>
                            <field name="file" filename="filename" widget="binary" readonly="state != 'draft'"/>
                            <field name="sheet_id" readonly="state != 'draft'" invisible="not sheet_ids"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="target_model_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="model_detection_score" widget="percentage" invisible="not model_detection_score"/>
                            <field name="template_id" readonly="state != 'mapped'" placeholder="Auto-detectada o seleccionar manual..."
                                   domain="[('model_id', '=', target_model_id)]"/>
                            <field name="user_id" readonly="1"/>
                            <field name="total_rows" readonly="1" invisible="not total_rows"/>
                            <field name="dropped_rows" readonly="1" invisible="not dropped_rows"/>
                        </group>
                        <group string="Deduplicación &amp; Política" invisible="state == 'draft'">
                            <field name="duplicate_criterion" readonly="state != 'mapped'"/>
                            <field name="duplicate_policy" readonly="state != 'mapped'"/>
                            <field name="duplicate_count_file" readonly="1"/>
                            <field name="duplicate_count_odoo" readonly="1" invisible="state not in ('queued', 'processing', 'done', 'error')"/>
                        </group>
                        <group string="Estadísticas de Ejecución" invisible="state not in ('queued', 'processing', 'done', 'error')">
                            <field name="progress_percent" widget="progressbar" readonly="1"/>
                            <field name="processed_rows" readonly="1"/>
                            <field name="created_rows" readonly="1"/>
                            <field name="updated_rows" readonly="1"/>
                            <field name="skipped_rows" readonly="1"/>
                            <field name="failed_rows" readonly="1"/>
                            <field name="start_time" readonly="1"/>
                            <field name="end_time" readonly="1"/>
                            <field name="duration_seconds" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="sheets" string="Hojas del archivo" invisible="not sheet_ids">
                            <field name="sheet_ids" readonly="1">
                                <list decoration-muted="kind != 'data'" decoration-bf="kind == 'data'">
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="visible" widget="boolean"/>
                                    <field name="row_count"/>
                                    <field name="column_count"/>
                                    <field name="detected_model_id" optional="show"/>
                                    <field name="detection_score" widget="percentage" optional="hide"/>
                                    <field name="dropped_rows"/>
                                    <field name="header_list" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page name="mappings" string="Mapeo de Columnas" invisible="state == 'draft'">
                            <field name="column_mapping_ids" readonly="state != 'mapped'">
                                <list editable="bottom" decoration-danger="is_conflict or model_fit == 'foreign'" decoration-muted="is_ignored">
                                    <field name="source_header" readonly="1"/>
                                    <field name="model_fit" readonly="1" widget="badge" optional="show"
                                           decoration-success="model_fit == 'ok'"
                                           decoration-danger="model_fit == 'foreign'"
                                           decoration-warning="model_fit == 'unknown'"
                                           decoration-muted="model_fit == 'ignored'"/>
                                    <field name="model_fit_note" readonly="1" optional="show"/>
                                    <field name="foreign_model_names" readonly="1" optional="hide"/>
                                    <field name="required_level" readonly="1" widget="badge" optional="show"
                                           decoration-danger="required_level == 'required'"
                                           decoration-info="required_level == 'conditional'"
                                           decoration-success="required_level == 'optional'"/>
                                    <field name="empty_count" string="Vacías" readonly="1" optional="show"
                                           decoration-danger="required_level == 'required' and empty_count &gt; 0"/>
                                    <field name="sample_values" readonly="1" optional="show"/>
                                    <field name="target_field_id" options="{'no_create': True}"
                                           domain="[('model_id', '=', parent.target_model_id)]"/>
                                    <field name="target_subfield" optional="hide"/>
                                    <field name="cleansing_rule_ids" widget="many2many_tags" options="{'color_field': 'action_type'}"/>
                                    <field name="source" readonly="1"/>
                                    <field name="confidence" readonly="1" widget="percentage"/>
                                    <field name="llm_justification" readonly="1" optional="show"/>
                                    <field name="is_ignored" widget="boolean_toggle"/>
                                    <field name="is_conflict" column_invisible="1"/>
                                    <field name="value_issue_overflow" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page name="value_corrections" string="Valores a revisar" invisible="not value_correction_ids">
                            <field name="value_correction_ids" readonly="state != 'mapped'">
                                <list editable="bottom" create="0" delete="0"
                                      decoration-warning="is_ambiguous" decoration-muted="source == 'memory'">
                                    <field name="original_value" readonly="1"/>
                                    <field name="occurrence_count" readonly="1"/>
                                    <field name="issue_type" readonly="1"/>
                                    <field name="suggested_label" readonly="1"/>
                                    <field name="confidence" readonly="1" widget="percentage"/>
                                    <field name="source" readonly="1" widget="badge"
                                           decoration-info="source == 'fuzzy'"
                                           decoration-success="source == 'memory'"
                                           decoration-muted="source == 'none'"/>
                                    <field name="decision"/>
                                    <field name="manual_value"/>
                                    <field name="is_ambiguous" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page name="ai_summary" string="🧠 Diagnóstico y Calidad IA" invisible="not ai_analysis_summary">
                            <group>
                                <field name="ai_template_name" readonly="1"/>
                            </group>
                            <div class="alert alert-info" role="status">
                                <strong>Análisis inteligente generado por la IA:</strong>
                                <field name="ai_analysis_summary" widget="text" readonly="1" nolabel="1"/>
                            </div>
                        </page>
                        <page name="preview" string="📊 Vista previa y tablero" invisible="state == 'draft'">
                            <field name="preview_data" widget="preview_table" nolabel="1"/>
                        </page>
                        <page name="jobs" string="Lotes" invisible="state not in ('queued', 'processing', 'done', 'error')">
                            <field name="job_ids" readonly="1">
                                <list decoration-info="state == 'pending'" decoration-warning="state == 'processing'" decoration-success="state == 'done'" decoration-danger="state == 'error'">
                                    <field name="chunk_index"/>
                                    <field name="row_from"/>
                                    <field name="row_to"/>
                                    <field name="attempts"/>
                                    <field name="state" widget="badge"/>
                                    <field name="error_message" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page name="column_errors" string="⚠️ Errores por columna" invisible="not error_summary_ids">
                            <div invisible="not precheck_error_summary_ids">
                                <h5>Antes de importar</h5>
                                <p class="text-muted">
                                    Celdas que Odoo no podrá aceptar, agrupadas por columna. Corrige el archivo y vuelve a analizar,
                                    o importa igual: esas filas quedarán como fallidas.
                                </p>
                                <field name="precheck_error_summary_ids" readonly="1" nolabel="1">
                                    <list create="0" delete="0">
                                        <field name="column_header"/>
                                        <field name="title" widget="badge" decoration-danger="1"/>
                                        <field name="row_count"/>
                                        <field name="message"/>
                                        <field name="hint"/>
                                        <field name="sample_values"/>
                                        <field name="rows_text" optional="show"/>
                                        <field name="field_label" optional="hide"/>
                                        <field name="technical_detail" optional="hide"/>
                                    </list>
                                </field>
                            </div>
                            <div invisible="not import_error_summary_ids">
                                <h5>Resultado de la importación</h5>
                                <field name="import_error_summary_ids" readonly="1" nolabel="1">
                                    <list create="0" delete="0">
                                        <field name="column_header"/>
                                        <field name="title" widget="badge" decoration-danger="1"/>
                                        <field name="row_count"/>
                                        <field name="message"/>
                                        <field name="hint"/>
                                        <field name="sample_values"/>
                                        <field name="rows_text" optional="show"/>
                                        <field name="field_label" optional="hide"/>
                                        <field name="technical_detail" optional="hide"/>
                                        <button name="action_view_rows" type="object" string="Ver filas" icon="fa-list"/>
                                    </list>
                                </field>
                                <button name="action_view_all_row_errors" type="object" class="btn btn-secondary"
                                        string="Ver todas las filas con error" icon="fa-table"/>
                            </div>
                        </page>
                        <page name="row_errors" string="Errores por fila" invisible="failed_rows == 0">
                            <field name="row_error_ids" readonly="1">
                                <list>
                                    <field name="row_number" string="Fila"/>
                                    <field name="column_header"/>
                                    <field name="cell_value"/>
                                    <field name="friendly_message"/>
                                    <field name="hint"/>
                                    <field name="error_type" optional="hide"/>
                                    <field name="error_message" optional="hide"/>
                                    <field name="raw_data" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>